{
  "network": {
    "state_dim": 24,
    "action_dim": 5,
    "chunk_size": 30,
    "executed_steps": 10,
    "critic_horizon": 10,
    "hidden_dims": [512, 512, 256],
    "use_images": false,
    "image_keys": [
      "observation.images.side_policy",
      "observation.images.wrist_1buchong",
      "observation.images.wrist_1",
      "observation.images.wrist_2"
    ],
    "image_feature_dim": 128
  },
  "iql": {
    "gamma": 0.99,
    "expectile": 0.7,
    "temperature": 3.0,
    "max_advantage_weight": 100.0,
    "critic_lr": 0.0003,
    "value_lr": 0.0003,
    "actor_lr": 0.00003,
    "backbone_lr": 0.0,
    "target_tau": 0.005,
    "prior_weight": 0.1,
    "grad_clip_norm": 10.0,
    "offline_fraction": 0.5
  },
  "batch_size": 8,
  "seed": 1000
}
